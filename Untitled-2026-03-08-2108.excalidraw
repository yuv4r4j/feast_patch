      "opacity": 100,
      "roundness": null,
      "seed": 731247548,
      "groupIds": [],
      "frameId": null,
      "boundElements": [],
      "updated": 1773030269757,
      "link": null,
      "locked": false,
      "isDeleted": false,
      "text": "Lineage BEFORE: .count() → ks_sc1 → bs_ks_all → merge → dedup × 4 → readsql() × 4 → Trino → SQL Server/Oracle",
      "fontSize": 11,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Lineage BEFORE: .count() → ks_sc1 → bs_ks_all → merge → dedup × 4 → readsql() × 4 → Trino → SQL Server/Oracle",
      "autoResize": true,
      "lineHeight": 1.25,
      "versionNonce": 712947577,
      "index": "b0G"
    },
