      "isDeleted": false,
      "boundElements": [],
      "updated": 1774616604725,
      "link": null,
      "locked": false,
      "text": "quick win: even a simple seasonal naive baseline beats this",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "quick win: even a simple seasonal naive baseline beats this",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "f0henLbfYUqLvM8r6y0WN",
      "type": "text",
      "x": 50.40020751953125,
      "y": 135,
      "width": 299.1995849609375,
      "height": 60,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "ad",
      "roundness": null,
      "seed": 1470665717,
      "version": 5,
      "versionNonce": 657708958,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1774616604726,
      "link": null,
      "locked": false,
      "text": "1  Glorified GROUP BY\nOne categorical feature per model.\nXGBoost just memorises means.",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "p1",
      "originalText": "1  Glorified GROUP BY\nOne categorical feature per model.\nXGBoost just memorises means.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "ySl3sMCJCrdOAjKUn3gv0",
      "type": "text",
      "x": 46.000213623046875,
      "y": 240,
      "width": 307.99957275390625,
      "height": 60,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "ae",
      "roundness": null,
      "seed": 96226645,
      "version": 5,
      "versionNonce": 408105950,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1774616604726,
      "link": null,
      "locked": false,
      "text": "2  Zero Time Awareness\nNo lags, trends, or seasonality.\nThis is averaging, not forecasting.",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "p2",
      "originalText": "2  Zero Time Awareness\nNo lags, trends, or seasonality.\nThis is averaging, not forecasting.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "ADLwf512Ob6WB392E7Q7o",
      "type": "text",
      "x": 37.200225830078125,
      "y": 345,
      "width": 325.59954833984375,
      "height": 60,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "af",
      "roundness": null,
      "seed": 533846709,
      "version": 5,
      "versionNonce": 498927646,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1774616604726,
      "link": null,
      "locked": false,
      "text": "3  LIMIT 2 Training History\nOnly last 2 months of actuals.\n500 trees on 2 months = pure overfit.",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "p3",
      "originalText": "3  LIMIT 2 Training History\nOnly last 2 months of actuals.\n500 trees on 2 months = pure overfit.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "4pnsPTYdSWKFi5k5OJW-X",
      "type": "text",
      "x": 46.000213623046875,
      "y": 450,
      "width": 307.99957275390625,
      "height": 60,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "ag",
      "roundness": null,
      "seed": 1854848021,
      "version": 5,
      "versionNonce": 929191006,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1774616604726,
      "link": null,
      "locked": false,
      "text": "4  Shuffled Train/Test Split\ntrain_test_split leaks future data.\nTime series needs chrono split.",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "p4",
      "originalText": "4  Shuffled Train/Test Split\ntrain_test_split leaks future data.\nTime series needs chrono split.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "V6UMRmOGxwBnZEfTQC1dv",
      "type": "text",
      "x": 456.0002136230469,
      "y": 135,
      "width": 307.99957275390625,
      "height": 60,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "ah",
      "roundness": null,
      "seed": 166228341,
      "version": 5,
      "versionNonce": 1058281630,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1774616604726,
      "link": null,
      "locked": false,
      "text": "5  Hardcoded Hyperparams\nn=500, depth=6, lr=0.05. No tuning.\nMassively over-parameterised.",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "p5",
      "originalText": "5  Hardcoded Hyperparams\nn=500, depth=6, lr=0.05. No tuning.\nMassively over-parameterised.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "I8G-b2mQrxQO2MZNwp3QS",
      "type": "text",
      "x": 464.8002014160156,
      "y": 240,
      "width": 290.39959716796875,
      "height": 60,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "ai",
      "roundness": null,
      "seed": 1864661717,
      "version": 5,
      "versionNonce": 746804446,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1774616604726,
      "link": null,
      "locked": false,
      "text": "6  In-Sample Predict Reuse\nmodel.predict(X) on ALL data incl\ntrain rows. Inflates accuracy.",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "p6",
      "originalText": "6  In-Sample Predict Reuse\nmodel.predict(X) on ALL data incl\ntrain rows. Inflates accuracy.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "5xXAZBsIUCzECvH_5mEXl",
      "type": "text",
      "x": 482.4001770019531,
      "y": 335,
      "width": 255.19964599609375,
      "height": 80,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aj",
      "roundness": null,
      "seed": 1457018933,
      "version": 5,
      "versionNonce": 1497434398,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1774616604726,
      "link": null,
      "locked": false,
      "text": "7  Inconsistent Features\nDM/Digital → CPA_SOURCE.\nSECA → ANNUAL_FEE_CONFIG.\nNo rationale. Fragments data.",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "p7",
      "originalText": "7  Inconsistent Features\nDM/Digital → CPA_SOURCE.\nSECA → ANNUAL_FEE_CONFIG.\nNo rationale. Fragments data.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "XNxn2zHvE84d7I6eq-QbV",
      "type": "text",
      "x": 478.00018310546875,
      "y": 440,
      "width": 263.9996337890625,
      "height": 80,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "ak",
      "roundness": null,
      "seed": 1256819093,
      "version": 5,
      "versionNonce": 1153316190,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1774616604726,
      "link": null,
      "locked": false,
      "text": "8  Silent Fallback Cascade\n4-level COALESCE degrades to\nchannel avg. No tracking which\nlevel actually drove output.",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "p8",
      "originalText": "8  Silent Fallback Cascade\n4-level COALESCE degrades to\nchannel avg. No tracking which\nlevel actually drove output.",
      "autoResize": true,
      "lineHeight": 1.25
    },
