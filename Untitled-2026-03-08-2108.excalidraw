    {
      "type": "text",
      "version": 8,
      "id": "fc8f748d09f94d02",
      "x": 80,
      "y": 1065,
      "width": 579.1495361328125,
      "height": 81.25,
      "angle": 0,
      "strokeColor": "#333333",
      "backgroundColor": "transparent",
      "fillStyle": "hachure",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "roundness": null,
      "seed": 649564286,
      "groupIds": [],
      "frameId": null,
      "boundElements": [],
      "updated": 1773030269757,
      "link": null,
      "locked": false,
      "isDeleted": false,
      "text": "Why the After works: Writing to Hive and reading back breaks the Spark lineage.\nWhen generate_ks_auc() calls .count() or .toPandas(), Spark traces back to the\nHive table (local read) instead of the 4 JDBC sources. The calculation code stays\nidentical — same code — but every action now reads from Hive instead of\nhammering prod 240 times.",
      "fontSize": 13,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Why the After works: Writing to Hive and reading back breaks the Spark lineage.\nWhen generate_ks_auc() calls .count() or .toPandas(), Spark traces back to the\nHive table (local read) instead of the 4 JDBC sources. The calculation code stays\nidentical — same code — but every action now reads from Hive instead of\nhammering prod 240 times.",
      "autoResize": true,
      "lineHeight": 1.25,
      "versionNonce": 1758884505,
      "index": "b0F"
    },
    {
      "type": "text",
      "version": 8,
      "id": "987f16aa79914398",
      "x": 80,
      "y": 1155,
      "width": 659.4486694335938,
      "height": 13.75,
      "angle": 0,
      "strokeColor": "#555555",
      "backgroundColor": "transparent",
      "fillStyle": "hachure",
      "strokeWidth": 1,
